	public function handle_save() {
		if ( ! current_user_can( 'manage_options' ) ) {
			wp_die( esc_html__( 'Unauthorized', 'pivotal-mega-menu' ) );
		}
		check_admin_referer( 'pmm_save_menu', 'pmm_nonce' );

		$defaults = $this->get_default_menu_data();
		$raw      = isset( $_POST['pmm_menu'] ) ? (array) $_POST['pmm_menu'] : [];
		$clean    = [];

		foreach ( array_values( $raw ) as $i => $item ) {
			$def     = $defaults[ $i ] ?? [];
			$entry   = [
				'label'    => sanitize_text_field( $item['label']   ?? '' ),
				'url'      => $this->sanitize_menu_url( $item['url'] ?? '#' ),
				'icon'     => sanitize_text_field( $item['icon']    ?? ( $def['icon'] ?? '' ) ),
				'section'  => sanitize_text_field( $item['section'] ?? ( $def['section'] ?? '' ) ),
				'wide'     => isset( $item['wide'] ) && $item['wide'] !== '0',
				'cols'     => intval( $item['cols'] ?? 1 ),
				'children' => [],
			];

			$raw_kids = isset( $item['children'] ) ? (array) $item['children'] : [];
			foreach ( array_values( $raw_kids ) as $j => $child ) {
				$def_child = $def['children'][ $j ] ?? [];
				if ( trim( $child['label'] ?? '' ) === '' ) continue; // skip blank rows
				$entry['children'][] = [
					'label' => sanitize_text_field( $child['label'] ),
					'url'   => $this->sanitize_menu_url( $child['url'] ?? '#' ),
					'icon'  => sanitize_text_field( $child['icon']  ?? ( $def_child['icon'] ?? 'fa-solid fa-circle-dot' ) ),
				];
			}

			$clean[] = $entry;
		}

		update_option( 'pmm_menu_data', $clean );

		wp_safe_redirect( add_query_arg( [ 'page' => 'pivotal-mega-menu', 'saved' => '1' ], admin_url( 'admin.php' ) ) );
		exit;
	}

	public function handle_reset() {
		if ( ! current_user_can( 'manage_options' ) ) {
			wp_die( esc_html__( 'Unauthorized', 'pivotal-mega-menu' ) );
		}
		check_admin_referer( 'pmm_reset_menu', 'pmm_nonce' );

		delete_option( 'pmm_menu_data' );

		wp_safe_redirect( add_query_arg( [ 'page' => 'pivotal-mega-menu', 'reset' => '1' ], admin_url( 'admin.php' ) ) );
		exit;
	}

	private function sanitize_menu_url( $url ) {
		$url = trim( $url );
		if ( '' === $url || '#' === $url ) return '#';
		return esc_url_raw( $url );
	}

